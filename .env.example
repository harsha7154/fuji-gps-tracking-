# Liferay Headless API base URL. Leave unset until the real endpoint is
# provided — the app is built to run and be tested even without it.
# EXPO_PUBLIC_LIFERAY_BASE_URL=https://your-liferay-host.example.com

# Google Maps Platform key used for the runtime Directions API REST call
# (remaining/green route + ETA). See src/services/directionsService.ts.
# Restrict this key to "Directions API" only in Google Cloud Console.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-directions-api-key

# FCM push relay (see fuji-push-relay/). Leave unset to disable push registration.
# EXPO_PUBLIC_PUSH_RELAY_URL=https://push.your-domain.example.com
